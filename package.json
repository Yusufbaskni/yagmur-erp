{
  "name": "yagmur-erp",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "productName": "Yagmur ERP",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "predev": "prisma migrate deploy && tsx prisma/seed.ts",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 43123",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "desktop": "node scripts/desktop.mjs",
    "desktop:build": "node scripts/prepare-standalone.mjs",
    "dist:mac": "node scripts/dist-mac.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.yagmurgida.erp",
    "productName": "Yagmur ERP",
    "executableName": "yagmur-erp",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "beforeBuild": "./scripts/skip-node-modules.cjs",
    "afterPack": "./scripts/after-pack.cjs",
    "files": [
      "electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      },
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations"
      },
      {
        "from": "electron/seed-bundle.cjs",
        "to": "seed-bundle.cjs"
      },
      {
        "from": "electron/apply-migrations.cjs",
        "to": "apply-migrations.cjs"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "dir"
      ]
    }
  }
}
